# Moises Bridge Dockerfile
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --break-system-packages httpx python-binance fastapi uvicorn

COPY moises_bridge.py /app/

CMD ["python", "/app/moises_bridge.py"]