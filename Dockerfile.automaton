# Build automaton from source
FROM node:20-slim AS builder

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/cli/package.json ./packages/cli/
COPY tsconfig.json ./

RUN npm install -g pnpm@10.28.1 && pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# Runtime stage
FROM node:20-slim

WORKDIR /app

# Install runtime deps
RUN apt-get update && apt-get install -y \
    python3 python3-pip \
    curl netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Copy built automaton
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Install python deps for IAF MCP
RUN pip3 install --break-system-packages python-binance

# Copy entrypoint
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create automaton user and fix /root permissions
# Allow automaton user to access /root/.automaton
RUN useradd -m -s /bin/bash automaton && \
    mkdir -p /home/automaton/.automaton /root/.automaton && \
    chown -R automaton:automaton /app /home/automaton /root/.automaton && \
    chmod 755 /root  # Allow automaton to traverse /root

USER automaton
ENV HOME=/home/automaton
ENV PATH="/home/automaton/.local/share/pnpm:/usr/local/bin:${PATH}"

EXPOSE 3001

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "dist/index.js", "--run"]